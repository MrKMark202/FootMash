<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <!-- Home -->
    <fragment
        android:id="@+id/nav_home"
        android:name="hr.fipu.footmash.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <!-- Lige tab (bottom-nav target) — direct list of seeded leagues -->
    <fragment
        android:id="@+id/nav_leagues"
        android:name="hr.fipu.footmash.ui.leagues.LeaguesFragment"
        android:label="@string/nav_leagues"
        tools:layout="@layout/fragment_leagues">
        <action
            android:id="@+id/action_leagues_to_teams"
            app:destination="@id/nav_teams_list" />
    </fragment>

    <!-- Teams list -->
    <fragment
        android:id="@+id/nav_teams"
        android:name="hr.fipu.footmash.ui.teams.TeamsFragment"
        android:label="@string/nav_teams"
        tools:layout="@layout/fragment_teams">
        <action
            android:id="@+id/action_teams_tab_to_detail"
            app:destination="@id/nav_team_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_teams_list"
        android:name="hr.fipu.footmash.ui.teams.TeamsFragment"
        android:label="@string/teams_title"
        tools:layout="@layout/fragment_teams">
        <argument
            android:name="leagueId"
            app:argType="integer" />
        <argument
            android:name="season"
            app:argType="integer" />
        <argument
            android:name="leagueName"
            app:argType="string" />
        <action
            android:id="@+id/action_teams_to_detail"
            app:destination="@id/nav_team_detail" />
    </fragment>

    <!-- Team detail -->
    <fragment
        android:id="@+id/nav_team_detail"
        android:name="hr.fipu.footmash.ui.teams.TeamDetailFragment"
        android:label="@string/team_details"
        tools:layout="@layout/fragment_team_detail">
        <argument
            android:name="teamId"
            app:argType="integer" />
        <argument
            android:name="leagueId"
            app:argType="integer" />
        <argument
            android:name="season"
            app:argType="integer" />
        <argument
            android:name="teamName"
            app:argType="string" />
        <action
            android:id="@+id/action_team_to_players"
            app:destination="@id/nav_players" />
        <action
            android:id="@+id/action_team_to_player_detail"
            app:destination="@id/nav_player_detail" />
    </fragment>

    <!-- Players -->
    <fragment
        android:id="@+id/nav_players"
        android:name="hr.fipu.footmash.ui.players.PlayersFragment"
        android:label="@string/players_title"
        tools:layout="@layout/fragment_players">
        <argument
            android:name="teamId"
            app:argType="integer" />
        <argument
            android:name="season"
            app:argType="integer" />
        <argument
            android:name="teamName"
            app:argType="string" />
        <action
            android:id="@+id/action_players_to_detail"
            app:destination="@id/nav_player_detail" />
    </fragment>

    <!-- Player detail -->
    <fragment
        android:id="@+id/nav_player_detail"
        android:name="hr.fipu.footmash.ui.players.PlayerDetailFragment"
        android:label="@string/player_details"
        tools:layout="@layout/fragment_player_detail">
        <argument
            android:name="playerData"
            app:argType="string" />
    </fragment>

    <!-- AI Lab -->
    <fragment
        android:id="@+id/nav_ai_lab"
        android:name="hr.fipu.footmash.ui.ailab.AILabFragment"
        android:label="@string/nav_ai_lab"
        tools:layout="@layout/fragment_ai_lab">
        <action
            android:id="@+id/action_aiLab_to_playerCreation"
            app:destination="@id/nav_player_identity" />
        <action
            android:id="@+id/action_aiLab_to_teamSimulation"
            app:destination="@id/teamSimulation" />
        <action
            android:id="@+id/action_aiLab_to_careerHub"
            app:destination="@id/nav_career_hub" />
    </fragment>

    <fragment
        android:id="@+id/teamSimulation"
        android:name="hr.fipu.footmash.ui.ailab.TeamSimulationFragment"
        android:label="Simulacija Tima"
        tools:layout="@layout/fragment_team_simulation" />

    <!-- Player creation wizard (4 steps + signed screen) -->
    <fragment
        android:id="@+id/nav_player_identity"
        android:name="hr.fipu.footmash.ui.ailab.create.PlayerIdentityFragment"
        android:label="Kreiraj igrača"
        tools:layout="@layout/fragment_player_identity">
        <action
            android:id="@+id/action_playerIdentity_to_playerStats"
            app:destination="@id/nav_player_stats" />
    </fragment>

    <fragment
        android:id="@+id/nav_player_stats"
        android:name="hr.fipu.footmash.ui.ailab.create.PlayerStatsFragment"
        android:label="Atributi i pozicija"
        tools:layout="@layout/fragment_player_stats">
        <action
            android:id="@+id/action_playerStats_to_playerPreview"
            app:destination="@id/nav_player_preview" />
    </fragment>

    <fragment
        android:id="@+id/nav_player_preview"
        android:name="hr.fipu.footmash.ui.ailab.create.PlayerPreviewFragment"
        android:label="Pregled igrača"
        tools:layout="@layout/fragment_player_preview">
        <action
            android:id="@+id/action_playerPreview_to_playerClubOffers"
            app:destination="@id/nav_player_club_offers" />
    </fragment>

    <fragment
        android:id="@+id/nav_player_club_offers"
        android:name="hr.fipu.footmash.ui.ailab.create.PlayerClubOffersFragment"
        android:label="Ponude klubova"
        tools:layout="@layout/fragment_player_club_offers">
        <action
            android:id="@+id/action_playerClubOffers_to_playerSigned"
            app:destination="@id/nav_player_signed"
            app:popUpTo="@id/nav_ai_lab"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/nav_player_signed"
        android:name="hr.fipu.footmash.ui.ailab.create.PlayerSignedFragment"
        android:label="Igrač potpisan"
        tools:layout="@layout/fragment_player_signed">
        <action
            android:id="@+id/action_playerSigned_to_careerHub"
            app:destination="@id/nav_career_hub" />
    </fragment>

    <fragment
        android:id="@+id/nav_career_hub"
        android:name="hr.fipu.footmash.ui.ailab.career.CareerHubFragment"
        android:label="Karijera"
        tools:layout="@layout/fragment_career_hub">
        <argument
            android:name="playerId"
            app:argType="integer" />
        <action
            android:id="@+id/action_careerHub_to_simulateSeason"
            app:destination="@id/nav_simulate_season" />
        <action
            android:id="@+id/action_careerHub_to_statGrowth"
            app:destination="@id/nav_stat_growth" />
        <action
            android:id="@+id/action_careerHub_to_transferOffers"
            app:destination="@id/nav_transfer_offers" />
        <action
            android:id="@+id/action_careerHub_to_winterTransfer"
            app:destination="@id/nav_transfer_offers" />
    </fragment>

    <fragment
        android:id="@+id/nav_stat_growth"
        android:name="hr.fipu.footmash.ui.ailab.career.StatGrowthFragment"
        android:label="Potroši bodove"
        tools:layout="@layout/fragment_stat_growth">
        <argument
            android:name="playerId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/nav_transfer_offers"
        android:name="hr.fipu.footmash.ui.ailab.career.TransferOffersFragment"
        android:label="Prelazni rok"
        tools:layout="@layout/fragment_transfer_offers">
        <argument
            android:name="playerId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/nav_simulate_season"
        android:name="hr.fipu.footmash.ui.ailab.career.SimulateSeasonFragment"
        android:label="Simulacija sezone"
        tools:layout="@layout/fragment_simulate_season">
        <argument
            android:name="playerId"
            app:argType="integer" />
    </fragment>

    <!-- Season Mode -->
    <fragment
        android:id="@+id/nav_season"
        android:name="hr.fipu.footmash.ui.season.LeaguePickerFragment"
        android:label="Sezona"
        tools:layout="@layout/fragment_league_picker">
        <action
            android:id="@+id/action_leaguePicker_to_clubMode"
            app:destination="@id/nav_club_mode" />
    </fragment>

    <fragment
        android:id="@+id/nav_club_mode"
        android:name="hr.fipu.footmash.ui.season.ClubModeFragment"
        android:label="Način igre"
        tools:layout="@layout/fragment_club_mode">
        <argument
            android:name="leagueId"
            app:argType="integer" />
        <argument
            android:name="leagueName"
            app:argType="string" />
        <action
            android:id="@+id/action_clubMode_to_clubSetup"
            app:destination="@id/nav_club_setup" />
        <action
            android:id="@+id/action_clubMode_to_existingClubPicker"
            app:destination="@id/nav_existing_club_picker" />
    </fragment>

    <fragment
        android:id="@+id/nav_club_setup"
        android:name="hr.fipu.footmash.ui.season.ClubSetupFragment"
        android:label="Osnivanje kluba"
        tools:layout="@layout/fragment_club_setup">
        <argument
            android:name="leagueId"
            app:argType="integer" />
        <argument
            android:name="leagueName"
            app:argType="string" />
        <action
            android:id="@+id/action_clubSetup_to_formationPicker"
            app:destination="@id/nav_formation_picker" />
    </fragment>

    <fragment
        android:id="@+id/nav_formation_picker"
        android:name="hr.fipu.footmash.ui.season.FormationPickerFragment"
        android:label="Formacija"
        tools:layout="@layout/fragment_formation_picker">
        <argument
            android:name="clubId"
            app:argType="integer" />
        <action
            android:id="@+id/action_formationPicker_to_draftCanvas"
            app:destination="@id/nav_draft_canvas" />
    </fragment>

    <fragment
        android:id="@+id/nav_existing_club_picker"
        android:name="hr.fipu.footmash.ui.season.ExistingClubPickerFragment"
        android:label="Postojeći klubovi"
        tools:layout="@layout/fragment_existing_club_picker">
        <argument
            android:name="leagueId"
            app:argType="integer" />
        <argument
            android:name="leagueName"
            app:argType="string" />
        <action
            android:id="@+id/action_existingClubPicker_to_draftCanvas"
            app:destination="@id/nav_draft_canvas" />
    </fragment>

    <fragment
        android:id="@+id/nav_draft_canvas"
        android:name="hr.fipu.footmash.ui.season.DraftCanvasFragment"
        android:label="Draft"
        tools:layout="@layout/fragment_draft_canvas">
        <argument
            android:name="clubId"
            app:argType="integer" />
        <argument
            android:name="editMode"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_draftCanvas_to_seasonHub"
            app:destination="@id/nav_season_hub" />
    </fragment>

    <fragment
        android:id="@+id/nav_season_hub"
        android:name="hr.fipu.footmash.ui.season.SeasonHubFragment"
        android:label="Sezona"
        tools:layout="@layout/fragment_season_hub">
        <argument
            android:name="clubId"
            app:argType="integer" />
        <action
            android:id="@+id/action_seasonHub_to_matchday"
            app:destination="@id/nav_matchday" />
        <action
            android:id="@+id/action_seasonHub_to_summary"
            app:destination="@id/nav_season_summary" />
        <action
            android:id="@+id/action_seasonHub_to_draft"
            app:destination="@id/nav_draft_canvas" />
    </fragment>

    <fragment
        android:id="@+id/nav_season_summary"
        android:name="hr.fipu.footmash.ui.season.SeasonSummaryFragment"
        android:label="Kraj sezone"
        tools:layout="@layout/fragment_season_summary">
        <argument
            android:name="clubId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/nav_matchday"
        android:name="hr.fipu.footmash.ui.season.MatchdayFragment"
        android:label="Kolo"
        tools:layout="@layout/fragment_matchday">
        <argument
            android:name="clubId"
            app:argType="integer" />
        <argument
            android:name="matchday"
            app:argType="integer" />
    </fragment>

</navigation>
