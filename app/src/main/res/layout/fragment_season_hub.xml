<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Club header card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardElevation="0dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/text_club_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:text="—" />

                    <TextView
                        android:id="@+id/text_league"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:text="Liga" />

                </LinearLayout>

                <TextView
                    android:id="@+id/text_budget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/success" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_squad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Uredi sastav i formaciju"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:backgroundTint="@color/divider"
                    app:cornerRadius="10dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Next match card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_next_match"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardElevation="0dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SLJEDEĆA UTAKMICA"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/text_matchday_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_blue"
                    android:text="Kolo 1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/text_home_team"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:maxLines="2"
                        android:text="—" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" vs "
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp" />

                    <TextView
                        android:id="@+id/text_away_team"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:maxLines="2"
                        android:text="—" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_simulate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Simuliraj kolo 1"
                    app:backgroundTint="@color/accent_blue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_simulate_season"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Simuliraj sezonu"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:backgroundTint="@color/divider"
                    app:cornerRadius="10dp" />

                <ProgressBar
                    android:id="@+id/progress_season"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Standings card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/surface"
            app:cardElevation="0dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TABLICA"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textColor="@color/text_secondary" />

                <!-- Header row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="#" android:textSize="11sp" android:textColor="@color/text_secondary" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tim" android:textSize="11sp" android:textColor="@color/text_secondary" />
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content"
                        android:text="OU" android:textSize="11sp" android:textColor="@color/text_secondary"
                        android:gravity="center" />
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="P" android:textSize="11sp" android:textColor="@color/text_secondary"
                        android:gravity="center" />
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="N" android:textSize="11sp" android:textColor="@color/text_secondary"
                        android:gravity="center" />
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="I" android:textSize="11sp" android:textColor="@color/text_secondary"
                        android:gravity="center" />
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                        android:text="Bod" android:textSize="11sp" android:textStyle="bold"
                        android:textColor="@color/text_secondary" android:gravity="center" />

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="4dp" />

                <!-- Dynamic rows added by fragment -->
                <LinearLayout
                    android:id="@+id/standings_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
